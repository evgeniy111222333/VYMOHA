{
  "name": "vymoha",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node -e \"fs.rmSync('dist/client/.vite', { recursive: true, force: true })\"",
    "start": "vinext start",
    "test": "vitest --config vitest.config.ts run",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:all": "npm run test && npm run test:render",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "indexnow": "node scripts/ping-indexnow.mjs",
    "db:generate": "drizzle-kit generate",
    "prod:local": "npm run build && npx wrangler dev -c dist/server/wrangler.json"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
